# InfinityFree Production Environment Configuration
# Copy this to .env and update with your actual credentials

APP_NAME="MAGIA LUPOS"
APP_ENV=production
APP_KEY=base64:GENERATE_THIS_LOCALLY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-domain.infinityfreeapp.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=sql123.infinityfree.com
DB_PORT=3306
DB_DATABASE=epiz_12345678_your_database
DB_USERNAME=epiz_12345678
DB_PASSWORD=your_database_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Security Settings
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# InfinityFree Specific Settings
# Note: These may not work on all InfinityFree servers
# You can also set them via .htaccess

# PHP Memory and Limits (if mod_php is available)
# PHP_MEMORY_LIMIT=256M
# PHP_MAX_EXECUTION_TIME=60
# PHP_UPLOAD_MAX_FILESIZE=10M
# PHP_POST_MAX_SIZE=10M

# Redis/Memcached (NOT AVAILABLE on InfinityFree)
# MEMCACHED_HOST=127.0.0.1
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# AWS S3 (Optional - for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (NOT AVAILABLE on InfinityFree - use log driver)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=mt1

# Vite (NOT NEEDED - assets are pre-built)
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_HOST="${PUSHER_HOST}"
# VITE_PUSHER_PORT="${PUSHER_PORT}"
# VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Agent (DISABLED on InfinityFree - no Python support)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# PYTHON_AGENT_URL=http://localhost:8001

# Additional Security
# Only enable if your server supports it
# FORCE_HTTPS=true
# TRUSTED_PROXIES=
